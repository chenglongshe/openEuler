+		*bit_pos = PS3_BIT_POS_DEFAULT;
+		ret = PS3_FALSE;
+		goto l_out;
+	}
+	ps3_atu_support = (union HilRegPs3RegisterFPs3AtuSupport *)&value;
+	*bit_pos = ps3_atu_support->reg.bitPos;
+l_out:
