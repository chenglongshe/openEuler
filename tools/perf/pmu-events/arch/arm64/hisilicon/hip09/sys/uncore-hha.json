	"ScaleUnit": "100%",
	"Compat": "0x00000030",
	"Unit": "hisi_sccl,hha"
   },
   {
	"MetricName": "hha_channel1_ops_rate",
	"MetricExpr": "hha_rx_ch1 / rx_ops_num",
